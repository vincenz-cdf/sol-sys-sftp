<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:sftp="http://www.mulesoft.org/schema/mule/sftp" xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/sftp http://www.mulesoft.org/schema/mule/sftp/current/mule-sftp.xsd">
	<sub-flow name="postEvents" doc:id="70abe53c-0e66-4ac5-b6fa-25ea03053675" >
		<sftp:write doc:name="Write original CSV" doc:id="9845ef8e-6d3a-4ac3-b0b0-dca7836a57eb" config-ref="SFTP_Config" path='#["/sftp/" ++ vars.date ++ ".csv"]'>
			<sftp:content ><![CDATA[#[%dw 2.0
output application/csv quoteValues=true
---
payload.users map {
    firstname: $.firstname,
    lastname: $.lastname,
    email: $.email,
    genres: $.genres joinBy ","
}]]]></sftp:content>
		</sftp:write>
		<logger level="INFO" doc:name="Logger" doc:id="dbc126e3-2bad-4e6e-83df-bf9c1b0beb7c" />
		<sftp:write doc:name="Write processed JSON" doc:id="9cf693b7-1d67-47fb-b3bf-1d9a9c1e3211" config-ref="SFTP_Config" path='#["/sftp/event_" ++ vars.date ++ ".json"]' >
			<sftp:content ><![CDATA[#[%dw 2.0
output application/json
---
payload.tracks]]]></sftp:content>
		</sftp:write>
	</sub-flow>
	<sub-flow name="listEvents" doc:id="bc9d2cd6-ea36-4621-ae8e-5abf6eac994e" >
		<sftp:list doc:name="List" doc:id="2074b77c-8781-4311-8f76-178e6b174aee" config-ref="SFTP_Config" directoryPath="sftp"/>
		<logger level="INFO" doc:name="Logger" doc:id="c24f9b66-13cf-4fba-9847-4d6310a0168b" />
	</sub-flow>
</mule>
